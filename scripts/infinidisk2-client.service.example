[Unit]
Description=InfiniDisk2 native Linux NBD attachment
After=infinidisk2-server.service
Requires=infinidisk2-server.service

[Service]
Type=simple
ExecStartPre=/sbin/modprobe nbd
ExecStart=/root/infinidisk2/target/release/infinidisk2 -c /root/infinidisk2/volume.toml attach --device /dev/nbd31 --connections 8
# Unmount the filesystem before stopping this service. Keep the same NBD reserved.
ExecStop=/root/infinidisk2/target/release/infinidisk2 -c /root/infinidisk2/volume.toml detach --device /dev/nbd31
Restart=no
TimeoutStopSec=70
UMask=0077

[Install]
WantedBy=multi-user.target
