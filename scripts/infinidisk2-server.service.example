[Unit]
Description=InfiniDisk2 Rust block server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/infinidisk2
EnvironmentFile=/root/infinidisk2/credentials.env
ExecStart=/root/infinidisk2/target/release/infinidisk2 -c /root/infinidisk2/volume.toml serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
KillSignal=SIGTERM
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
