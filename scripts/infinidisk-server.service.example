[Unit]
Description=InfiniDisk Rust block server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/
EnvironmentFile=/etc/infinidisk/credentials.env
ExecStart=/usr/local/bin/infinidisk -c /etc/infinidisk/volume.toml serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
KillSignal=SIGTERM
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
